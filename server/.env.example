PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL installation password; keep DATABASE_URL unset when using these.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=soulpaw
PGUSER=postgres
PGPASSWORD=YOUR_POSTGRES_PASSWORD
# Register these exact callback URLs in each provider console.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:4000/api/auth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:4000/api/auth/naver/callback
